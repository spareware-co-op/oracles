# geomdl 5.4.0 (MIT), its wheel pinned by SHA-256, on a Python image pinned by digest. Built by this
# repository's workflow and never pushed.
FROM python:3.13-slim@sha256:2d44738ebf4ce5f63b9d9ea871e9c7cfdc0426f7b0c97cac915fd88ded1d86bb
COPY requirements.txt harness.py /oracle/
RUN pip install --no-cache-dir --no-deps --require-hashes -r /oracle/requirements.txt
ENTRYPOINT ["python", "/oracle/harness.py"]
